{
  "name": "warren-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Personal portfolio for Warren Villagonzalo Gallardo. Vanilla HTML, CSS, and JavaScript.",
  "type": "module",
  "scripts": {
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint \"js/**/*.js\" --ignore-pattern \"js/vendor/*.min.js\"",
    "lint:css": "stylelint \"css/**/*.css\"",
    "format": "prettier --write \"**/*.{js,css,html,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,css,html,json,md}\""
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "prettier": "^3.4.2",
    "stylelint": "^16.12.0",
    "stylelint-config-standard": "^36.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
