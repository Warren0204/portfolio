{
  "printWidth": 100,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "es5",
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": "*.css",
      "options": { "singleQuote": true }
    },
    {
      "files": "*.html",
      "options": { "printWidth": 120 }
    }
  ]
}
